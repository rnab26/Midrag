# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Where uploaded/generated files live on disk.
DATA_DIR=./data

# --- GPU backend ---
# "mock"   -> no GPU needed, just copies the source face onto the output so you can test the whole app.
# "runpod" -> calls your real RunPod serverless endpoint running FaceFusion.
SWAP_BACKEND=mock

# Only needed when SWAP_BACKEND=runpod. Get these after deploying runpod_worker/ (see its README).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Base URL RunPod can use to fetch your uploaded files (must be publicly reachable, e.g. an ngrok/
# Cloudflare tunnel URL in dev, or your real domain in production). Not needed in mock mode.
PUBLIC_BASE_URL=http://localhost:8000
